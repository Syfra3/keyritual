{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAED evidence manifest v1",
  "type": "object",
  "required": ["version", "created_utc", "repositories", "checks", "artifacts", "invariants"],
  "properties": {
    "version": {"const": 1},
    "created_utc": {"type": "string"},
    "repositories": {"type": "array", "items": {"type": "object", "required": ["root", "role", "status"]}},
    "checks": {"type": "array", "items": {"type": "object", "required": ["argv", "status", "exit_code", "counts", "evidence"]}},
    "invariants": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "description", "checks"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "checks": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}}}},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
