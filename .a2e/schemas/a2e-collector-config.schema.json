{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A2E collector config (JSON-compatible YAML)",
  "type": "object", "additionalProperties": false,
  "required": ["version", "collectors"],
  "properties": {
    "version": {"const": 1},
    "collectors": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "patterns", "required", "category", "boundary"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "script": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}, "category": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1}, "budget": {"type": "number"}
      }
    }}
  }
}
